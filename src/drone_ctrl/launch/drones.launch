<launch>
  <group ns="drone_0">
    <node pkg="drone_ctrl" type="drone_node" name="drone_node" output="screen">
      <param name="drone_id" value="0"/> <param name="off_x" value="-17"/> <param name="off_y" value="-3"/>
    </node>
  </group>
  <group ns="drone_1">
    <node pkg="drone_ctrl" type="drone_node" name="drone_node" output="screen">
      <param name="drone_id" value="1"/> <param name="off_x" value="-14"/> <param name="off_y" value="-3"/>
    </node>
  </group>
  <group ns="drone_2">
