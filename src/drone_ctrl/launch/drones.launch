    </node>
  </group>
  <group ns="drone_3">
    <node pkg="drone_ctrl" type="drone_node" name="drone_node" output="screen">
      <param name="drone_id" value="3"/> <param name="off_x" value="-14"/> <param name="off_y" value="0"/>
    </node>
  </group>
  <group ns="drone_4">
    <node pkg="drone_ctrl" type="drone_node" name="drone_node" output="screen">
      <param name="drone_id" value="4"/> <param name="off_x" value="-17"/> <param name="off_y" value="3"/>
