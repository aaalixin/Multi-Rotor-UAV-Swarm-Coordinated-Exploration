<launch>
  <arg name="route_id" default="0"/>  <!-- 路线0-6, 对应contX.py,contX_1..4,contX_6,contX_7 -->


  <!-- 3. C++ 巡逻 x6 最后启动 -->
  <group ns="drone_0">
    <node pkg="drone_ctrl" type="simple_explore" name="se" output="log"><param name="drone_id" value="0"/><param name="route_id" value="$(arg route_id)"/></node>
  </group>
  <group ns="drone_1">
    <node pkg="drone_ctrl" type="simple_explore" name="se" output="log"><param name="drone_id" value="1"/><param name="route_id" value="$(arg route_id)"/></node>
  </group>
  <group ns="drone_2">
    <node pkg="drone_ctrl" type="simple_explore" name="se" output="log"><param name="drone_id" value="2"/><param name="route_id" value="$(arg route_id)"/></node>
  </group>
  <group ns="drone_3">
    <node pkg="drone_ctrl" type="simple_explore" name="se" output="log"><param name="drone_id" value="3"/><param name="route_id" value="$(arg route_id)"/></node>
  </group>
  <group ns="drone_4">
    <node pkg="drone_ctrl" type="simple_explore" name="se" output="log"><param name="drone_id" value="4"/><param name="route_id" value="$(arg route_id)"/></node>
  </group>
  <group ns="drone_5">
    <node pkg="drone_ctrl" type="simple_explore" name="se" output="log"><param name="drone_id" value="5"/><param name="route_id" value="$(arg route_id)"/></node>
  </group>
</launch>
